[user]
	email = jyi2ya@qq.com
	name = jyi
[core]
	editor = vim
	quotePath = false
	pager = less -FRX
[merge]
	tool = vimdiff
	conflictStyle = zdiff3
[pull]
    rebase = true
[credential]
	helper = store
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = master
[pager]
	diff = less -FRSX
	show = less -FRSX
	log = less -FRX
[diff]
	algorithm = histogram
	context = 20
	interHunkContext = 60
	colorMoved = zebra
	colorMovedWS = allow-indentation-change
	renames = copies
	renameLimit = 0
	statGraphWidth = 60
	statNameWidth = 40
	wsErrorHighlight = all
	submodule = log
[color]
	ui = auto
[log]
	date = iso-local
	decorate = auto
	abbrevCommit = true
	follow = true
[blame]
	date = iso-local
	coloring = highlightRecent
	markUnblamableLines = true
	markIgnoredLines = true
[branch]
	sort = -committerdate
[tag]
	sort = -creatordate
[column]
	ui = auto
[status]
	showUntrackedFiles = all
[rerere]
	enabled = true
[fetch]
	prune = true
[rebase]
	autoSquash = true
	autoStash = true
[help]
	autoCorrect = prompt
